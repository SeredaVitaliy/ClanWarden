# --- Обязательные ---

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Clash of Clans API: https://developer.clashofclans.com
# Ключ привязан к IP сервера — создавайте его для IP той машины, где работает бот.
COC_API_TOKEN=

# --- Необязательные ---

# Как часто опрашивать API, в секундах (минимум 30)
POLL_INTERVAL_SECONDS=120

# Где хранить базу. В Docker менять не нужно.
# DATABASE_PATH=data/cocbot.db

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# Адрес API. Можно указать прокси, если у сервера нет постоянного IP.
# COC_API_BASE_URL=https://api.clashofclans.com/v1

# --- Быстрая настройка одного клана (вместо /setclan) ---
# Если заполнить, группа будет привязана к клану при первом запуске.
# CLAN_TAG=#ABC123
# GROUP_CHAT_ID=-1001234567890
# GROUP_THREAD_ID=
