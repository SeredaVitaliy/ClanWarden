# --- Required ---

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Clash of Clans API key: https://developer.clashofclans.com
# Keys are bound to IP addresses — create the key for the IP of the machine running the bot.
COC_API_TOKEN=

# --- Optional ---

# How often to poll the API, in seconds (minimum 30)
POLL_INTERVAL_SECONDS=120

# Where to store the database. No need to change it in Docker.
# DATABASE_PATH=data/clanwarden.db

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# API base URL. Point it to a proxy if your server has no static IP.
# COC_API_BASE_URL=https://api.clashofclans.com/v1

# --- Single-clan quick setup (instead of /setclan) ---
# If set, the group is connected to the clan on first start.
# CLAN_TAG=#2PP
# GROUP_CHAT_ID=-1001234567890
# GROUP_THREAD_ID=
